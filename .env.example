# Optional Hugging Face access token. Leave blank for public downloads when no token is required.
HF_TOKEN=

# Persistent cache path. Use a mounted/persistent volume when available.
HF_HOME=/workspace/.cache/huggingface

# Model selection
MODEL_ID=MiniMaxAI/MiniMax-H3
MODEL_VARIANT=fl2va
# Leave MODEL_PATH empty to use the local checkpoint when present, otherwise MODEL_ID.
MODEL_PATH=

# SGLang server
HOST=0.0.0.0
PORT=30010

# Layer-wise CPU offloading: 1=enabled (default), 0=disabled.
ENABLE_OFFLOADING=1
OFFLOAD_COMPONENTS=dit,text_encoder,vae
RESIDENT_LAYERS=video_vae=36

# Warmup settings. These affect startup warmup, not the requested output video.
WARMUP_RESOLUTIONS=864x480
WARMUP_NUM_FRAMES=124

# PyTorch CUDA allocator setting; override only when testing another allocator configuration.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Set DRY_RUN=1 to print the exact SGLang command without launching the model.
DRY_RUN=0
