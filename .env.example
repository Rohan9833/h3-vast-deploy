# Optional Hugging Face access token. Leave blank for public downloads when no token is required.
HF_TOKEN=

# Persistent cache path. Change this to a mounted/persistent Vast volume if available.
HF_HOME=/workspace/.cache/huggingface

# SGLang server
HOST=0.0.0.0
PORT=30010

# Inference profile: recipe_a (default) or recipe_b (faster, higher memory pressure)
SGLANG_PROFILE=recipe_a

# Conservative free disk target before downloading FL2VA (GiB)
MIN_DISK_GIB=150

# Runtime free-space headroom checked by install.sh after download (GiB)
MIN_INSTALL_DISK_GIB=10
